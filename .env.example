REDIS_URL=redis://redis:6379/0
JWT_SECRET=some_test_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# App
APP_PORT=8000
ENVIRONMENT=DEV # PROD or DEV
LOG_LEVEL=INFO # DEBUG, INFO, WARNING, ERROR, CRITICAL
# Postgres
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbdb
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# CART
GUEST_CART_MAX_AGE=2592000 # 30 days


# reset-password
RESET_TOKEN_PREFIX="pwd_reset:"
RESET_TOKEN_TTL_SECONDS=3600  # 60 minutes


# EMAIL
MAIL_SERVER=smtp.example.com
MAIL_USERNAME=username
MAIL_PASSWORD=P@ssword
MAIL_PORT=2525
MAIL_FROM="from@example.com"